        "kind": "calendar",
        "entries": [
          {
            "hour": 9,
            "minute": 0
          }
        ]
      },
      "cwd": "/Users/me/src",
      "created_at": "2026-09-02T10:30:00-04:00",
      "paused": false,
      "quiet": false,
      "timeout": 1800
    },
    "sync": {
