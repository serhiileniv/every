# A CRLF shebang doesn't run on Linux — `env: 'ruby\r': No such file or
# directory`, before a line of every ever loads. This repo is edited from
# Windows too, so everything a Unix box executes or parses is pinned to LF no
# matter what core.autocrlf is set to locally.
* text=auto

install.sh     text eol=lf
install.ps1    text eol=lf
bin/every      text eol=lf
*.rb           text eol=lf
*.sh           text eol=lf
completions/*  text eol=lf
man/*          text eol=lf

*.png binary
*.gif binary

# Golden fixtures are compared byte-for-byte, so nothing may rewrite them.
# `* text=auto` above would CRLF-munge them on a Windows checkout -- and the
# Task Scheduler fixtures are UTF-16LE, where a line-ending rewrite corrupts
# the encoding outright rather than just changing bytes.
testdata/golden/** binary
